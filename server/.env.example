PORT=8787

# 펌웨어 config.h 의 DEVICE_TOKEN 과 같은 값
DEVICE_TOKEN=change-me

# 설정하면 대시보드에서 식물 수정/채팅/시뮬레이션 시 이 토큰이 필요하다 (외부 공개 시 필수)
ADMIN_TOKEN=

# Claude API. 키를 쓰려면 주석을 풀고 채운다 (빈 값으로 두면 `ant auth login` 프로필을 가린다)
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CHAT_LANGUAGE=한국어
OWNER_NAME=주인

# Discord 단체 채팅 (선택). 셋 다 있어야 활성화된다.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=

# 1 이면 Wi-Fi 없는 센서에 이 맥(서버)이 BLE 로 연결해 값을 계속 받는다. 센서 근처(약 10m)에서 실행해야 한다.
BLE_ENABLED=0

# 바깥 날씨 (Open-Meteo, 키 필요 없음). 대화와 아침 인사에 쓰인다.
# 위치를 비워 두면 서버의 공인 IP 로 도시 단위 위치를 찾는다(ipwho.is, 실패하면 서울).
# 정확한 동네를 쓰려면 위도/경도를 넣는다. WEATHER_PLACE 는 화면과 대화에 보이는 이름.
# WEATHER_PLACE=강남구
# WEATHER_LAT=37.4979
# WEATHER_LON=127.0276
# WEATHER_ENABLED=0

# 매일 7~9시 사이 무작위 시각에 식물이 날씨와 함께 먼저 인사한다. 0 이면 끈다.
MORNING_GREETING=1

# 기상청 단기예보 (선택). 공공데이터포털(data.go.kr)에서 "기상청_단기예보 조회서비스"를 활용 신청하고
# 마이페이지의 일반 인증키 중 "Decoding" 키를 넣는다. 비워 두면 Open-Meteo 날씨만 쓴다.
KMA_SERVICE_KEY=

# 공휴일 (date.nager.at, 키 필요 없음). 오늘 쉬는 날인지 Claude 가 안다. 0 이면 끈다.
HOLIDAY_COUNTRY=KR
# HOLIDAYS_ENABLED=0

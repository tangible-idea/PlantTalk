PORT=8787

# 펌웨어 config.h 의 DEVICE_TOKEN 과 같은 값
DEVICE_TOKEN=change-me

# 설정하면 대시보드에서 식물 수정/채팅/시뮬레이션 시 이 토큰이 필요하다 (외부 공개 시 필수)
ADMIN_TOKEN=

# Claude API. 키를 쓰려면 주석을 풀고 채운다 (빈 값으로 두면 `ant auth login` 프로필을 가린다)
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CHAT_LANGUAGE=한국어
OWNER_NAME=주인

# Discord 단체 채팅 (선택). 셋 다 있어야 활성화된다.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=

# 1 이면 Wi-Fi 없는 센서에 이 맥(서버)이 BLE 로 연결해 값을 계속 받는다. 센서 근처(약 10m)에서 실행해야 한다.
BLE_ENABLED=0
